{
  "name": "yaanstep-tests",
  "version": "0.3.0",
  "private": true,
  "description": "Playwright + TypeScript test automation for Yaanstep. Separate project from the site and the apps. Owned by QA.",
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright show-report reports/html",
    "summary": "node scripts/summary.mjs",
    "typecheck": "tsc --noEmit",
    "test:maths": "playwright test tests/website/maths-draft",
    "test:maths:quick": "playwright test tests/website/maths-draft.spec.ts",
    "test:reading": "playwright test tests/website/reading-draft"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "http-server": "^14.1.1",
    "typescript": "^5.9.0"
  }
}
